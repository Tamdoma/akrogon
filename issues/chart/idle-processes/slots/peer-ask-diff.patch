diff --git i/skills/chart-issues/scripts/peer-ask.ts w/skills/chart-issues/scripts/peer-ask.ts
new file mode 100644
index 0000000..32844de
--- /dev/null
+++ w/skills/chart-issues/scripts/peer-ask.ts
@@ -0,0 +1,37 @@
+#!/usr/bin/env bun
+import { existsSync } from 'node:fs';
+import { parseBudget, waitForReturn } from './peer-wait';
+
+// Prompting and waiting are one call, so a peer's answer is collected before A can move on to anything else.
+async function main(): Promise<void> {
+  if (process.argv.length !== 6) {
+    process.stderr.write('Usage: peer-ask.ts <pane> <return-file> <budget-seconds> <message>\n');
+    process.exit(1);
+  }
+  const pane: string = process.argv[2];
+  const file: string = process.argv[3];
+  const budgetSeconds: number = parseBudget(process.argv[4]);
+  const message: string = process.argv[5];
+  if (existsSync(file)) {
+    process.stderr.write(`Return file already exists, use a fresh path per exchange: ${file}\n`);
+    process.exit(1);
+  }
+  const prompt: Bun.SyncSubprocess<'pipe', 'pipe'> = Bun.spawnSync(
+    ['herdr', 'agent', 'prompt', pane, message, '--wait', '--until', 'working', '--timeout', '5000'],
+    { stdin: 'ignore', stdout: 'pipe', stderr: 'pipe' },
+  );
+  if (prompt.exitCode !== 0) {
+    process.stderr.write(`herdr agent prompt ${pane} failed (exit ${prompt.exitCode}): ${prompt.stderr.toString()}`);
+    process.exit(prompt.exitCode);
+  }
+  await waitForReturn(pane, file, budgetSeconds);
+}
+
+if (import.meta.main) {
+  try {
+    await main();
+  } catch (error) {
+    process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
+    process.exit(1);
+  }
+}
